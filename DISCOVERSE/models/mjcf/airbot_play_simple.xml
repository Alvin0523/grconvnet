<mujoco model="airbot_play">

  <include file="scene.xml"/>
  <include file="airbot_play/airbot_play_options.xml"/>
  <include file="airbot_play/airbot_play_dependencies.xml"/>

  <asset>
    <mesh name="t_left" file="airbot_play/left.obj" scale="1 1 1"/>
    <mesh name="t_right" file="airbot_play/right.obj" scale="1 1 1"/>
  </asset>

  <worldbody>
    <!-- ======= AITBOT PLAY ======= -->
    <body name="arm_pose" pos="0 0.20 0.78" euler="0 0 0">
      <include file="airbot_play/airbot_play.xml"/>
    </body>

    <!-- <body name="target" pos="0.2764 0.2 0.9966" quat="-1 0 0 0" mocap="true">
        <geom type="sphere" size="0.05" contype="0" conaffinity="0" rgba="0.6 0.3 0.3 0.6"/>
    </body> -->

    <body name="target" pos="0.2764 0.2 0.9966" quat="-1 0 0 0" mocap="true">
      <body name="rot_rot" pos="0 0 0" euler="0 1.57 0">
        <body name="t_right" pos="0 0 0">
          <geom contype="0" conaffinity="0" type="mesh" mesh="t_right" rgba="0.6 0.3 0.3 0.6"/>
        </body>
        <body name="t_left" pos="0 0 0">
          <geom contype="0" conaffinity="0" type="mesh" mesh="t_left" rgba="0.6 0.3 0.3 0.6"/>
        </body>
      </body>
    </body>

    <!-- <camera name="eye_from_top" fovy="72.02" pos="0 -0.3 1.2" quat="0 0 0 1"/> -->
    <camera name="eye_from_top" fovy="42.46" pos="0 -0.3 1.6" quat="0 0 0 1"/>

    <!-- ======= TABLE write ======= -->
    <body name="table-a" pos="0 0 0">
      <geom size="0.4 0.6 0.01" pos="0 0 0.77" type="box" rgba="0.7 0.7 0.7 1" condim="4" solimp="2 1 0.01" solref="0.01 1" friction="1 0.005 0.0001"/>
      <geom size="0.02 0.02 0.385" pos=" 0.28  0.56 0.385" type="box" contype="0" conaffinity="0" rgba="0.7 0.7 0.7 1" />
      <geom size="0.02 0.02 0.385" pos="-0.28  0.56 0.385" type="box" contype="0" conaffinity="0" rgba="0.7 0.7 0.7 1" />
      <geom size="0.02 0.02 0.385" pos=" 0.28 -0.56 0.385" type="box" contype="0" conaffinity="0" rgba="0.7 0.7 0.7 1" />
      <geom size="0.02 0.02 0.385" pos="-0.28 -0.56 0.385" type="box" contype="0" conaffinity="0" rgba="0.7 0.7 0.7 1" />
    </body>

    <!-- <body name="workspace" pos="0 0 1.2">
      <geom size="0.3 0.6 0.42" pos="0 0 0" type="box" contype="0" conaffinity="0" rgba="0.3 0.3 0.6 0.5"/>
    </body> -->

  </worldbody>

  <equality>
    <joint joint1='endleft' joint2='endright' polycoef='0 -1 0 0 0 '/>
  </equality>

  <actuator>
    <include file="airbot_play/airbot_play_control.xml"/>
  </actuator>

  <sensor>
    <include file="airbot_play/airbot_play_sensor.xml"/>
  </sensor>

  <keyframe>
    <key qpos='0 0 0 0 0 0 0 0'/>
  </keyframe>

</mujoco>
